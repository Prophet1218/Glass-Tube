<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="bottom"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="6dp"
    android:visibility="gone">

    <!-- the video itself is placed over this slot -->
    <View
        android:id="@+id/miniThumb"
        android:layout_width="75dp"
        android:layout_height="42dp" />

    <LinearLayout
        android:id="@+id/miniText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/miniTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/miniChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <com.example.glasstube.PlayPauseView
        android:id="@+id/miniPlay"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_pause"
        android:padding="9dp" />

    <ImageView
        android:id="@+id/miniClose"
        android:layout_width="38dp"
        android:layout_height="42dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:padding="10dp"
        android:src="@drawable/ic_x" />
</LinearLayout>
